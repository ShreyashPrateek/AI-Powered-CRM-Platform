# ── Server ────────────────────────────────────────────────────────────────────
PORT=8088
LOG_LEVEL=INFO

# ── HuggingFace Models ────────────────────────────────────────────────────────
# CPU-friendly default. Replace with GPU models when running on GPU hardware:
#   GENERATION_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
#   GENERATION_MODEL=mistralai/Mistral-7B-Instruct-v0.3
GENERATION_MODEL=microsoft/phi-2
GENERATION_MAX_NEW_TOKENS=512
GENERATION_TEMPERATURE=0.7
GENERATION_TOP_P=0.9

SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Device ────────────────────────────────────────────────────────────────────
# "auto" uses GPU if available, else CPU
DEVICE=auto

# ── Model cache ───────────────────────────────────────────────────────────────
HF_CACHE_DIR=/tmp/hf_cache
