# ChromaDB configuration for CRM Platform
# Collections used:
#   crm_deals  — deal documents for RAG chatbot
#   crm_leads  — lead documents for RAG chatbot
#
# ChromaDB runs as a standalone HTTP server (port 8000).
# The AI service connects via chromadb Python client using CHROMA_HOST / CHROMA_PORT env vars.
#
# To pre-create collections (optional — the AI service creates them on first use):
#   POST http://localhost:8000/api/v1/collections
#   { "name": "crm_deals", "metadata": { "hnsw:space": "cosine" } }
#   { "name": "crm_leads", "metadata": { "hnsw:space": "cosine" } }

CHROMA_SERVER_HOST=0.0.0.0
CHROMA_SERVER_HTTP_PORT=8000
ANONYMIZED_TELEMETRY=False
ALLOW_RESET=False
